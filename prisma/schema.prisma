generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  MANAGER
  DRIVER
  SOLICITANTE
}

enum ShipmentStatus {
  EN_PREPARACION
  LISTO_PARA_ENVIAR
  ASIGNADO_CHOFER
  EN_CAMINO
  ENTREGADO
  INCIDENCIA
  CANCELADO
}

enum ShipmentSource {
  TIENDANUBE
  REMITO
  MANUAL
}

enum IncidentType {
  DESTINATARIO_AUSENTE
  DIRECCION_INCORRECTA
  PAQUETE_RECHAZADO
  ACCESO_IMPOSIBLE
  OTRO
}

enum RuleType {
  POSTAL_CODE
  PROVINCE
  CITY
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  active       Boolean  @default(true)
  isOwner      Boolean  @default(false)
  createdAt    DateTime @default(now())

  shipmentsCreated      Shipment[]   @relation("CreatedBy")
  shipmentsAssigned     Shipment[]   @relation("AssignedDriver")
  shipmentsRequested    Shipment[]   @relation("RequestedBy")
  events                ShipmentEvent[]
  routes                Route[]
  labelBatchesCreated   LabelBatch[] @relation("LabelCreatedBy")
  labelBatchesConfirmed LabelBatch[] @relation("LabelConfirmedBy")

  @@map("users")
}

model LogisticsCompany {
  id                  String   @id @default(cuid())
  name                String
  isInternal          Boolean  @default(false)
  active              Boolean  @default(true)
  website             String?
  trackingUrlTemplate String?
  notes               String?
  createdAt           DateTime @default(now())

  shipments    Shipment[]
  routingRules RoutingRule[]
}

model RoutingRule {
  id                 String           @id @default(cuid())
  logisticsCompany   LogisticsCompany @relation(fields: [logisticsCompanyId], references: [id])
  logisticsCompanyId String
  type               RuleType
  pattern            String
  priority           Int              @default(0)
  active             Boolean          @default(true)
  notes              String?
  createdAt          DateTime         @default(now())
}

model Shipment {
  id            String         @id @default(cuid())
  trackingToken String         @unique @default(uuid())
  orderNumber   String?
  source        ShipmentSource
  status        ShipmentStatus @default(EN_PREPARACION)

  recipientName  String
  recipientPhone String?
  addressLine    String
  addressExtra   String?
  city           String
  province       String
  postalCode     String?

  lat Float?
  lng Float?

  products String?
  notes    String?
  saleDate DateTime?

  logisticsCompanyId   String?
  logisticsCompany     LogisticsCompany? @relation(fields: [logisticsCompanyId], references: [id])
  externalTrackingCode String?
  externalTrackingUrl  String?

  rawPdfData Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdBy        User  @relation("CreatedBy", fields: [createdById], references: [id])
  createdById      String
  assignedDriver   User? @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  assignedDriverId String?
  requestedBy      User? @relation("RequestedBy", fields: [requestedById], references: [id])
  requestedById    String?

  events          ShipmentEvent[]
  routeItems      RouteItem[]
  labelBatchItems LabelBatchItem[]

  @@map("shipments")
}

model ShipmentEvent {
  id           String          @id @default(cuid())
  shipment     Shipment        @relation(fields: [shipmentId], references: [id])
  shipmentId   String
  fromStatus   ShipmentStatus?
  toStatus     ShipmentStatus
  notes        String?
  incidentType IncidentType?
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime        @default(now())

  @@map("shipment_events")
}

model Route {
  id          String    @id @default(cuid())
  driver      User      @relation(fields: [driverId], references: [id])
  driverId    String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  items RouteItem[]

  @@map("routes")
}

model RouteItem {
  id            String    @id @default(cuid())
  route         Route     @relation(fields: [routeId], references: [id])
  routeId       String
  shipment      Shipment  @relation(fields: [shipmentId], references: [id])
  shipmentId    String
  deliveryOrder Int
  segment       Int       @default(1)
  deliveredAt   DateTime?

  @@map("route_items")
}

model LabelBatch {
  id            String    @id @default(cuid())
  createdBy     User      @relation("LabelCreatedBy", fields: [createdById], references: [id])
  createdById   String
  confirmedBy   User?     @relation("LabelConfirmedBy", fields: [confirmedById], references: [id])
  confirmedById String?
  generatedAt   DateTime  @default(now())
  confirmedAt   DateTime?

  items LabelBatchItem[]

  @@map("label_batches")
}

model LabelBatchItem {
  id         String     @id @default(cuid())
  batch      LabelBatch @relation(fields: [batchId], references: [id])
  batchId    String
  shipment   Shipment   @relation(fields: [shipmentId], references: [id])
  shipmentId String

  @@map("label_batch_items")
}
